{
  "name": "save-editor",
  "version": "1.0.0",
  "description": "游戏存档修改器 - 轻松解锁所有关卡",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win nsis msi --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --publish never",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": ["save-editor", "game", "unlocker"],
  "author": "批发哈密瓜",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}